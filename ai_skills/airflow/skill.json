{
  "version": 2,
  "name": "airflow",
  "display_name": "Airflow 数据工作流",
  "kind": "knowledge",
  "capability_group": "optional-plugin",
  "source_type": "bundled_plugin",
  "source_format": "agent_skill",
  "default_enabled": false,
  "description": "Apache Airflow operations skill using Astronomer Agents, astro-airflow-mcp, and the af CLI.",
  "description_cn": "Apache Airflow 运维能力，基于 Astronomer Agents、astro-airflow-mcp 与 af CLI 查询、诊断和管理 DAG。",
  "presentation": {
    "category": "data_analysis",
    "short_name": "Airflow",
    "summary": "查询、诊断和管理 Airflow 数据工作流。",
    "examples": ["检查 DAG 状态", "定位任务失败原因", "查看运行日志"],
    "access_note": "使用时会连接你配置的 Airflow 环境；可能改变运行状态的操作仍需明确确认。"
  },
  "tags": ["airflow", "astronomer", "astro-airflow-mcp", "af", "dag", "mcp"],
  "triggers": ["Airflow", "DAG", "af dags", "airflow health", "DAG run", "task logs", "为什么 DAG 失败"],
  "anti_triggers": ["Superset", "ShowDoc", "WeKnora", "warehouse SQL analytics"],
  "tool_refs": ["run_skill_script"],
  "references": ["SOURCE.md", "api-reference.md"],
  "script_refs": ["scripts/run_af.py"],
  "script_entries": [
    {
      "name": "run_af",
      "path": "scripts/run_af.py",
      "runtime": "python",
      "description": "Run the Astronomer af CLI with skill-provided Airflow credentials. Blocks common write operations when AF_READ_ONLY is true."
    }
  ],
  "config_fields": [
    {
      "name": "AIRFLOW_API_URL",
      "label": "Airflow API URL",
      "kind": "text",
      "required": true,
      "env": "AIRFLOW_API_URL",
      "placeholder": "https://airflow.example.com"
    },
    {
      "name": "AIRFLOW_AUTH_TOKEN",
      "label": "Auth Token",
      "kind": "secret",
      "required": false,
      "env": "AIRFLOW_AUTH_TOKEN",
      "placeholder": "Preferred token auth"
    },
    {
      "name": "AIRFLOW_USERNAME",
      "label": "Username",
      "kind": "text",
      "required": false,
      "env": "AIRFLOW_USERNAME",
      "placeholder": "Alternative username auth"
    },
    {
      "name": "AIRFLOW_PASSWORD",
      "label": "Password",
      "kind": "secret",
      "required": false,
      "env": "AIRFLOW_PASSWORD",
      "placeholder": "Alternative password auth"
    },
    {
      "name": "AF_READ_ONLY",
      "label": "Read Only",
      "kind": "text",
      "required": false,
      "env": "AF_READ_ONLY",
      "default": "true",
      "placeholder": "true"
    }
  ],
  "config_requirements": [
    {
      "any_of": [["AIRFLOW_AUTH_TOKEN"], ["AIRFLOW_USERNAME", "AIRFLOW_PASSWORD"]],
      "message": "Airflow requires AIRFLOW_AUTH_TOKEN or AIRFLOW_USERNAME + AIRFLOW_PASSWORD."
    }
  ],
  "mcp_server_presets": [
    {
      "id": "airflow",
      "name": "Airflow MCP",
      "description": "Astronomer astro-airflow-mcp stdio server.",
      "enabled": true,
      "transport": "stdio",
      "timeout_seconds": 60,
      "runtime": "skill_python",
      "module": "astro_airflow_mcp",
      "args": ["--transport", "stdio"],
      "env": {
        "AIRFLOW_API_URL": "{{AIRFLOW_API_URL}}",
        "AIRFLOW_AUTH_TOKEN": "{{AIRFLOW_AUTH_TOKEN}}",
        "AIRFLOW_USERNAME": "{{AIRFLOW_USERNAME}}",
        "AIRFLOW_PASSWORD": "{{AIRFLOW_PASSWORD}}",
        "AF_READ_ONLY": "{{AF_READ_ONLY}}"
      }
    }
  ],
  "python_dependencies": ["astro-airflow-mcp>=0.9.1,<1"],
  "node_dependencies": [],
  "workflow": [
    "Use read-only af commands first: health, dags list, runs list, tasks logs, and diagnose.",
    "Saving this Skill configuration automatically enables its managed MCP server; use it for tool-based Airflow access.",
    "Require explicit confirmation before write operations such as trigger, clear, delete, pause, unpause, POST, PATCH, or DELETE."
  ]
}
