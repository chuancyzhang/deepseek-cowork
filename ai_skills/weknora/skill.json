{
  "version": 2,
  "name": "weknora",
  "kind": "knowledge",
  "capability_group": "optional-plugin",
  "source_type": "bundled_plugin",
  "source_format": "agent_skill",
  "default_enabled": false,
  "description": "Official WeKnora MCP skill for knowledge-base import, browsing, and retrieval.",
  "description_cn": "WeKnora 官方 MCP 知识库能力，支持知识导入、浏览和检索。",
  "tags": ["weknora", "knowledge base", "retrieval", "hybrid search", "知识库", "mcp"],
  "triggers": ["WeKnora", "知识库检索", "上传知识库", "导入网页到知识库", "hybrid search", "知识库搜索"],
  "anti_triggers": ["Superset", "Airflow", "ShowDoc", "腾讯文档"],
  "tool_refs": [],
  "references": ["SOURCE.md"],
  "script_refs": ["scripts/run_mcp.py"],
  "config_fields": [
    {
      "name": "WEKNORA_BASE_URL",
      "label": "WeKnora API 地址",
      "kind": "text",
      "required": true,
      "env": "WEKNORA_BASE_URL",
      "placeholder": "https://your-weknora.example.com/api/v1"
    },
    {
      "name": "WEKNORA_API_KEY",
      "label": "WeKnora API Key",
      "kind": "secret",
      "required": true,
      "env": "WEKNORA_API_KEY",
      "placeholder": "sk-..."
    }
  ],
  "mcp_server_presets": [
    {
      "id": "weknora",
      "name": "WeKnora MCP",
      "description": "Official WeKnora stdio MCP server running in the Cowork Skill Python sandbox.",
      "enabled": true,
      "transport": "stdio",
      "timeout_seconds": 60,
      "runtime": "skill_python",
      "entrypoint": "scripts/run_mcp.py",
      "env": {
        "WEKNORA_BASE_URL": "{{WEKNORA_BASE_URL}}",
        "WEKNORA_API_KEY": "{{WEKNORA_API_KEY}}"
      }
    }
  ],
  "python_dependencies": ["weknora-mcp-server==1.0.0"],
  "node_dependencies": [],
  "workflow": [
    "Saving WEKNORA_BASE_URL and WEKNORA_API_KEY automatically enables the managed WeKnora MCP server.",
    "Use WeKnora only for knowledge-base import, browsing, and retrieval tasks.",
    "Require explicit confirmation before editing or deleting an existing knowledge entry."
  ]
}
