    {"id":"team", "kind":"page", "target":"team"},
    {"id":"plugins", "kind":"page", "target":"plugins"},
    {"id":"workspace", "kind":"panel", "target":"workspace"},
    {"id":"files", "kind":"panel", "target":"files"},
    {"id":"tasks", "kind":"panel", "target":"tasks"},
    {"id":"browser", "kind":"panel", "target":"browser"},
    {"id":"terminal", "kind":"panel", "target":"terminal"},
    {"id":"office", "kind":"editor", "target":"*"}
