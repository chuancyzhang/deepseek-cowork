# Copy to .env; keep it private. Use a URL-safe random password or percent-encode it in the DSN.
POSTGRES_PASSWORD=replace_with_a_random_password
COWORK_DATABASE_URL=postgresql+psycopg://cowork:replace_with_a_random_password@database:5432/cowork
COWORK_HOST=cowork.example.internal
COWORK_PUBLIC_URL=https://cowork.example.internal
COWORK_PLATFORM_ID=company-cowork
COWORK_PLATFORM_NAME=企业 Cowork
COWORK_ENCRYPTION_KEY=replace_with_generate_key_output
COWORK_BOOTSTRAP_PROVIDER=
COWORK_BOOTSTRAP_SUBJECT=
# Optional with one enabled source; required when multiple sources are enabled.
COWORK_LOGIN_PROVIDER=
COWORK_SESSION_SECONDS=28800
COWORK_MAX_MODEL_CONCURRENCY=64
COWORK_CLEANUP_SECONDS=60
